{
  "manifest_version": 3,
  "name": "EventPing",
  "version": "0.0.1",
  "description": "Automatically finds and reminds you about registration forms in your emails",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "identity",
    "activeTab"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*.eventbrite.com/*",
    "*://*.lu.ma/*",
    "*://*.typeform.com/*",
    "*://forms.gle/*",
    "*://*.meetup.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.eventbrite.com/*",
        "*://*.lu.ma/*",
        "*://*.typeform.com/*",
        "*://forms.gle/*",
        "*://*.meetup.com/*",
        "*://*.eventbrite.co.uk/*",
        "*://*.eventbrite.ca/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
